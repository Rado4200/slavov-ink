# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings > Environment Variables.

# Public base URL used for metadata (canonical links, Open Graph).
# Optional: on Vercel the deployment URL is detected automatically.
NEXT_PUBLIC_SITE_URL=

# --- Google Drive portfolio source (used from Phase 4) ---------------------
# ID of the root Drive folder. Each subfolder becomes a portfolio category.
# Found in the folder URL: https://drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_FOLDER_ID=

# Option A: API key (simplest; the folder must be shared "Anyone with the link").
# Restrict the key to the Google Drive API in Google Cloud Console.
GOOGLE_API_KEY=

# Option B: service account (folder can stay private; share it with the
# service account email as Viewer). Use instead of GOOGLE_API_KEY.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service account JSON, with newlines escaped as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- On-demand revalidation ------------------------------------------------
# Long random string protecting the revalidate endpoint (e.g. `openssl rand -hex 32`).
REVALIDATE_SECRET=

# Include dev-only routes (e.g. /dev/type) in a build. Leave unset in production.
ENABLE_DEV_ROUTES=

# Search indexing. Leave unset until launch; "on" makes the site indexable
# (robots.txt, X-Robots-Tag and meta robots). Needs a redeploy to take effect.
SITE_INDEXING=

# Footer build stamp ("build 1a2b3c4"). Shown unless set to "off" (set off at launch).
SHOW_BUILD_STAMP=

# --- Contact form (EmailJS REST API; public browser keys by design) --------
# Leave empty until the EmailJS account exists: the form renders and shows a
# localized "not connected yet" message on submit (never a fake success).
# Template parameters: from_name, reply_to, message.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
